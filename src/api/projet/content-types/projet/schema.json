{
  "kind": "collectionType",
  "collectionName": "projets",
  "info": {
    "singularName": "projet",
    "pluralName": "projets",
    "displayName": "projet"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Titre": {
      "type": "string",
      "required": true
    },
    "Type": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "Titre"
    },
    "Categorie": {
      "type": "string",
      "required": true
    },
    "descriptionCourte": {
      "type": "text",
      "required": true
    },
    "descriptionLongue": {
      "type": "richtext"
    },
    "Lien": {
      "type": "string",
      "required": false
    },
    "stack": {
      "type": "component",
      "component": "shared.stack",
      "repeatable": true
    },
    "Image": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "badges": {
      "type": "component",
      "component": "shared.projet-badge",
      "repeatable": true
    },
    "liens": {
      "type": "component",
      "component": "shared.projet-lien",
      "repeatable": true
    }
  }
}
