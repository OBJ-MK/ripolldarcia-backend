{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "article "
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Titre": {
      "type": "string",
      "default": "Community management en 2026 : les règles ont changé",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "Titre"
    },
    "Contenu": {
      "type": "blocks",
      "required": true
    },
    "Resume": {
      "type": "text",
      "required": true
    },
    "Image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Categorie": {
      "type": "string",
      "default": "Design",
      "required": true
    }
  }
}
